{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-delivery-arena.example/schemas/run-save.schema.json",
  "title": "AI Delivery Arena run save",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "scenario",
    "run",
    "checkpoint",
    "integrity"
  ],
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "scenario": {
      "$ref": "#/$defs/scenarioIdentity"
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "checkpoint": {
      "$ref": "#/$defs/checkpoint"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "$defs": {
    "scenarioIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scenario_id",
        "scenario_version",
        "fixture_fingerprint"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "scenario_version": {
          "type": "string",
          "minLength": 1
        },
        "fixture_fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "revision",
        "status",
        "terminal_route",
        "investigation_schedule",
        "decisions"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "in_progress",
            "completed"
          ]
        },
        "terminal_route": {
          "type": [
            "string",
            "null"
          ]
        },
        "investigation_schedule": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRequest"
          }
        },
        "decisions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/decision"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "terminal_route": {
                "type": "string",
                "minLength": 1
              },
              "decisions": {
                "minItems": 20,
                "maxItems": 20
              }
            }
          },
          "else": {
            "properties": {
              "terminal_route": {
                "type": "null"
              },
              "decisions": {
                "maxItems": 19
              }
            }
          }
        }
      ]
    },
    "evidenceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "request_week",
        "arrival_week",
        "cost",
        "first_use"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "request_week": {
          "type": "integer",
          "minimum": 0
        },
        "arrival_week": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "type": "integer",
          "minimum": 1
        },
        "first_use": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "evidence_id",
        "summary",
        "facts",
        "selected_rule_ids"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^D[0-9]{2}$"
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "selected_rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value": true,
        "status": {
          "enum": [
            "asserted",
            "supported",
            "contradicted",
            "superseded"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_decisions",
        "ledger_entries",
        "ledger_head",
        "ledger"
      ],
      "properties": {
        "completed_decisions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^D[0-9]{2}$"
          }
        },
        "ledger_entries": {
          "type": "integer",
          "minimum": 0
        },
        "ledger_head": {
          "$ref": "#/$defs/sha256"
        },
        "ledger": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ledgerEntry"
          }
        }
      }
    },
    "ledgerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "kind",
        "week",
        "decision_id",
        "payload",
        "previous_hash",
        "event_hash"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "evidence_requested",
            "evidence_available",
            "evidence_verified",
            "decision_recorded",
            "rule_applied",
            "crisis_observed",
            "crisis_resolved",
            "gate_adjudicated",
            "run_completed"
          ]
        },
        "week": {
          "type": "integer",
          "minimum": 0
        },
        "decision_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload": {
          "type": "object"
        },
        "previous_hash": {
          "$ref": "#/$defs/sha256"
        },
        "event_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sha256",
            "hmac-sha256"
          ]
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
